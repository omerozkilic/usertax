  "description": "Deterministic core of usertax: report schema, diffing, attribution, budgets and rendering.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omerozkilic/usertax.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },

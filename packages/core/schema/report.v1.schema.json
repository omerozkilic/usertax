{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "usertax"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "git": {
      "type": "object",
      "properties": {
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "sha"
      ]
    },
    "settings": {
      "type": "object",
      "properties": {
        "compression": {
          "type": "object",
          "properties": {
            "gzipLevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            },
            "brotliQuality": {
              "type": "integer",
              "minimum": 0,
              "maximum": 11
            }
          },
          "required": [
            "gzipLevel",
            "brotliQuality"
          ]
        }
      },
      "required": [
        "compression"
      ]
    },
    "environment": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string",
          "maxLength": 100
        },
        "node": {
          "type": "string",
          "maxLength": 50
        },
        "cpu": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "apps": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[\\w@./-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "kind": {
            "type": "string",
            "enum": [
              "web",
              "react-native"
            ]
          },
          "framework": {
            "type": "string",
            "enum": [
              "vite",
              "next",
              "nuxt",
              "astro",
              "sveltekit",
              "webpack",
              "expo",
              "react-native",
              "static",
              "other"
            ]
          },
          "assets": {
            "maxItems": 10000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "js",
                    "css",
                    "html",
                    "font",
                    "image",
                    "json",
                    "wasm",
                    "other"
                  ]
                },
                "raw": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "gzip": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "brotli": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "packages": {
                  "maxItems": 5000,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 214
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "versions": {
                        "minItems": 2,
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "version": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "bytes": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "version",
                            "bytes"
                          ]
                        }
                      }
                    },
                    "required": [
                      "name",
                      "bytes"
                    ]
                  }
                },
                "firstPartyBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "unattributedBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "modules": {
                  "maxItems": 5000,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "package": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 214
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "path",
                      "bytes"
                    ]
                  }
                }
              },
              "required": [
                "key",
                "file",
                "type",
                "raw"
              ]
            }
          },
          "routes": {
            "maxItems": 2000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "route": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "assets": {
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                }
              },
              "required": [
                "route",
                "assets"
              ]
            }
          },
          "bundles": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "platform": {
                  "type": "string",
                  "enum": [
                    "ios",
                    "android"
                  ]
                },
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "js",
                    "hermes"
                  ]
                },
                "raw": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "gzip": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "brotli": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "packages": {
                  "maxItems": 5000,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 214
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "versions": {
                        "minItems": 2,
                        "maxItems": 50,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "version": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            },
                            "bytes": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "version",
                            "bytes"
                          ]
                        }
                      }
                    },
                    "required": [
                      "name",
                      "bytes"
                    ]
                  }
                },
                "firstPartyBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "unattributedBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "modules": {
                  "maxItems": 5000,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "package": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 214
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "path",
                      "bytes"
                    ]
                  }
                }
              },
              "required": [
                "platform",
                "file",
                "format",
                "raw"
              ]
            }
          },
          "archives": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "format": {
                  "type": "string",
                  "enum": [
                    "apk",
                    "aab",
                    "ipa"
                  ]
                },
                "platform": {
                  "type": "string",
                  "enum": [
                    "ios",
                    "android"
                  ]
                },
                "fileSize": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "entryCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "categories": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "category": {
                        "type": "string",
                        "enum": [
                          "js-bundle",
                          "dex",
                          "native",
                          "resources",
                          "assets",
                          "binary",
                          "frameworks",
                          "other"
                        ]
                      },
                      "compressed": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "uncompressed": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "category",
                      "compressed",
                      "uncompressed",
                      "count"
                    ]
                  }
                },
                "entries": {
                  "maxItems": 50000,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024
                      },
                      "category": {
                        "type": "string",
                        "enum": [
                          "js-bundle",
                          "dex",
                          "native",
                          "resources",
                          "assets",
                          "binary",
                          "frameworks",
                          "other"
                        ]
                      },
                      "compressed": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "uncompressed": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "path",
                      "category",
                      "compressed",
                      "uncompressed"
                    ]
                  }
                },
                "omittedEntries": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "compressed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "uncompressed": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "count",
                    "compressed",
                    "uncompressed"
                  ]
                }
              },
              "required": [
                "key",
                "file",
                "format",
                "platform",
                "fileSize",
                "entryCount",
                "categories",
                "entries"
              ]
            }
          },
          "lighthouse": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "formFactor": {
                  "type": "string",
                  "enum": [
                    "mobile",
                    "desktop"
                  ]
                },
                "lighthouseVersion": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                },
                "runs": {
                  "minItems": 1,
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "performance": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      },
                      "lcp": {
                        "type": "number",
                        "minimum": 0
                      },
                      "tbt": {
                        "type": "number",
                        "minimum": 0
                      },
                      "cls": {
                        "type": "number",
                        "minimum": 0
                      },
                      "contamination": {
                        "type": "object",
                        "properties": {
                          "origins": {
                            "minItems": 1,
                            "maxItems": 20,
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            }
                          },
                          "requestCount": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "origins",
                          "requestCount"
                        ]
                      }
                    },
                    "required": [
                      "performance",
                      "lcp",
                      "tbt",
                      "cls"
                    ]
                  }
                }
              },
              "required": [
                "url",
                "formFactor",
                "lighthouseVersion",
                "runs"
              ]
            }
          },
          "dependencies": {
            "maxItems": 50000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 214
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "direct": {
                  "type": "boolean"
                },
                "dev": {
                  "type": "boolean"
                },
                "via": {
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 214
                  }
                }
              },
              "required": [
                "name",
                "version",
                "direct"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "path",
          "kind",
          "framework"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "tool",
    "createdAt",
    "settings",
    "apps"
  ]
}

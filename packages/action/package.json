{
  "name": "@usertax/action",
  "version": "0.1.1",
  "private": true,
  "description": "GitHub Action for usertax: measure pull requests and comment with what they cost users.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "@usertax/source": "./src/index.ts",
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "scripts": {
    "bundle": "node scripts/bundle.js"
  },
  "dependencies": {
    "@usertax/core": "workspace:*",
    "@usertax/measure": "workspace:*",
    "usertax": "workspace:*"
  },
  "files": [
    "action.yml",
    "dist/index.js"
  ]
}

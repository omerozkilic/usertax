{
  "$schema": "../packages/core/schema/config.schema.json",
  "apps": [
    {
      "path": "examples/vite-app",
      "id": "vite",
      "lighthouse": {
        "pages": ["/"],
        "runs": 3
      }
    },
    {
      "path": "examples/next-app",
      "id": "next",
      "lighthouse": {
        "pages": ["/"],
        "runs": 3
      }
    },
    {
      "path": "examples/expo-app",
      "id": "expo"
    },
    {
      "path": "examples/bare-rn-app",
      "id": "bare-rn",
      "framework": "react-native",
      "bundles": [
        {
          "platform": "android",
          "file": "dist/android/index.android.bundle"
        },
        {
          "platform": "ios",
          "file": "dist/ios/main.jsbundle"
        }
      ]
    }
  ],
  "budgets": [
    {
      "metric": "route[*].js.gzip",
      "maxIncrease": "10 kB",
      "level": "warn"
    }
  ]
}

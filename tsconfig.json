{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "*.ts",
    "*.js",
    "scripts/*.js",
    "packages/*/scripts/*.js",
    "packages/cli/bin/*.js",
    "packages/*/test/**/*.ts",
    "packages/*/vitest.config.ts"
  ]
}
